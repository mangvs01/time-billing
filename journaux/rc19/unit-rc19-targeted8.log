ty.addEventListener(\'input\',updateAmount);project.addEventListener(\'change\',()=>{rate=0;document.getElementById(\'rawHours\').textContent=\'—\';document.getElementById(\'rawDays\').textContent=\'—\';qty.value=\'\';updateAmount()});\nconst markBal=()=>document.querySelectorAll(\'.p-balances .bal\').forEach(b=>b.classList.toggle(\'sel\',b.dataset.pid===project.value));project.addEventListener(\'change\',markBal);markBal();const tsel=document.querySelector(\'#entryForm select[name=project_id]\');if(tsel){const markT=()=>document.querySelectorAll(\'.p-balances .bal\').forEach(b=>b.classList.toggle(\'tsel\',b.dataset.pid===tsel.value));tsel.addEventListener(\'change\',markT);markT();}\n</script><script nonce="yNyos8i-N6Io7aH5AdlJiA">/* rc14 : chaque libellé de champ est relié à son champ (lecteurs d\'écran, clic sur le libellé) */document.querySelectorAll(\'.field>label:not([for])\').forEach(function(l,i){if(l.querySelector(\'input,select,textarea\'))return;var c=l.parentElement.querySelector(\'input:not([type=hidden]):not([type=radio]):not([type=checkbox]),select,textarea\');if(!c)return;if(!c.id)c.id=\'fld-\'+i+\'-\'+(c.name||\'x\');l.htmlFor=c.id});document.addEventListener(\'submit\',function(e){var m=e.target&&e.target.dataset&&e.target.dataset.confirm;if(m&&!window.confirm(m))e.preventDefault()},true)</script>\n</body></html>'

