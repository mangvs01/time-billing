t,#000 85%,transparent);padding-right:24px}\n  #filters::-webkit-scrollbar{display:none}#filters button{flex:none}\n  .imp .card{padding:12px 14px}.imp .card strong{font-size:22px}\n  table.cards tr{background:rgba(255,255,255,.72);border:1px solid var(--line);border-radius:16px;padding:10px 14px;box-shadow:var(--hl)}\n  table.cards tr:hover>td{background:transparent}\n  table.cards tr.subrow{margin:-4px 0 10px 16px;background:rgba(14,22,33,.03)}\n  table.cards tr[hidden],table.cards tr.subrow[hidden]{display:none}\n  table.cards tr.subrow td{background:transparent}\n  table.cards td{display:block;font-size:13px;padding:5px 0;text-align:right;overflow:hidden}\n  table.cards td::before{float:left;max-width:42%;margin-right:12px;text-align:left;color:var(--ink-3);font-weight:600}\n  table.cards td>.actions{display:inline-flex;justify-content:flex-end}\n  table.cards td.actions>a,table.cards td.actions>form,table.cards td.actions>button{display:inline-flex;margin:0 0 6px 6px}\n  .scrollhint:has(+table.cards),.scrollhint:has(+.tablewrap>table.cards){display:none}\n  table.cards td:empty{display:none}\n  table.cards td.actions{padding-top:8px}\n}\n/* ---------- préférences d\'accessibilité ---------- */\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n@media (prefers-reduced-transparency:reduce){.panel,.sidebar,.kpi,.ringcard,.msg,.loginbox,.card{-webkit-backdrop-filter:none;backdrop-filter:none;background:#fff}}\n@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.panel,.sidebar,.kpi,.ringcard,.msg,.loginbox{background:rgba(255,255,255,.94)}}</style></head><body><div class="shell"><a class="skip" href="#contenu">Aller au contenu</a><aside class="sidebar"><div class="brand"><span class="logo" aria-hidden="true"></span><div><h1>Time Billing V9.2</h1></div></div>\n<nav class="tabs" aria-label="Navigation principale">\n<a href="/?tab=dashboard" title="Tableau de bord" >Tableau 